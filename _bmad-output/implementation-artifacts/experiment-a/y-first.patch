+
+class SubmitForConfirmationTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        users = get_user_model().objects
+        cls.reporter = users.create_user(username='confirmation_reporter')
+        cls.handler = users.create_user(username='confirmation_handler')
+        cls.other_handler = users.create_user(username='confirmation_other_handler')
+        group = Group.objects.create(name=HANDLER_GROUP)
+        group.user_set.add(cls.handler, cls.other_handler)
+        cls.ticket = create_ticket(
+            reporter=cls.reporter, device_name='打印机', location='公共区', description='卡纸',
+        )
+        claim_ticket(ticket_id=cls.ticket.pk, handler=cls.handler, expected_version=cls.ticket.version)
+        cls.ticket.refresh_from_db()
+
+    def setUp(self):
+        self.url = reverse('repair-submit', args=[self.ticket.pk])
+        self.detail_url = reverse('ticket-detail', args=[self.ticket.pk])
+        self.payload = {'version': self.ticket.version, 'content': '已清理卡纸。\n试打通过。'}
+
+    def test_assignee_submits_result_and_reporter_can_accept(self):
+        browser = Client(enforce_csrf_checks=True)
+        browser.force_login(self.handler)
+        detail = browser.get(self.detail_url)
+        self.assertContains(detail, f'action="{self.url}"')
+        self.assertContains(detail, '处理结果')
+        self.assertEqual(browser.post(self.url, self.payload).status_code, 403)
+        self.assertRedirects(browser.post(self.url, {
+            **self.payload, 'csrfmiddlewaretoken': browser.cookies['csrftoken'].value,
+        }), self.detail_url)
+
+        current = Ticket.objects.get(pk=self.ticket.pk)
+        self.assertEqual(current.status, Ticket.Status.AWAITING_CONFIRMATION)
+        self.assertEqual(current.assignee_id, self.handler.pk)
+        self.assertEqual(current.version, self.ticket.version + 1)
+        event = current.events.get(action=TicketEvent.Action.SUBMITTED)
+        self.assertEqual((event.actor, event.content, event.version, event.occurred_at), (
+            self.handler, self.payload['content'], current.version, current.updated_at,
+        ))
+        self.assertNotContains(browser.get(self.detail_url), f'action="{self.url}"')
+
+        self.client.force_login(self.reporter)
+        detail = self.client.get(self.detail_url)
+        self.assertContains(detail, '<dd>待确认</dd>', html=True)
+        self.assertContains(detail, self.payload['content'])
+        close_url = reverse('repair-close', args=[current.pk])
+        self.assertContains(detail, f'action="{close_url}"')
+        self.assertRedirects(self.client.post(close_url, {'version': current.version}), self.detail_url)
+        current.refresh_from_db()
+        self.assertEqual(current.status, Ticket.Status.CLOSED)
+
+    def test_only_current_assignee_with_handler_role_can_submit(self):
+        for user in (self.reporter, self.other_handler):
+            with self.subTest(user=user.username):
+                self.client.force_login(user)
+                self.assertEqual(self.client.post(self.url, self.payload).status_code, 403)
+        self.client.force_login(self.reporter)
+        self.assertNotContains(self.client.get(self.detail_url), f'action="{self.url}"')
+        self.handler.groups.clear()
+        self.client.force_login(self.handler)
+        self.assertEqual(self.client.post(self.url, self.payload).status_code, 403)
+        self.assertFalse(self.ticket.events.filter(action=TicketEvent.Action.SUBMITTED).exists())
+
+    def test_invalid_input_and_failed_event_write_leave_ticket_in_progress(self):
+        self.client.force_login(self.handler)
+        self.assertEqual(self.client.get(self.url).status_code, 405)
+        for content in ('', ' \n\t ', '修' * (NOTE_LIMIT + 1)):
+            self.assertEqual(self.client.post(self.url, {**self.payload, 'content': content}).status_code, 400)
+        with patch('repairs.services.TicketEvent.objects.create', side_effect=IntegrityError('event insert failed')):
+            with self.assertRaises(IntegrityError):
+                self.client.post(self.url, self.payload)
+
+        current = Ticket.objects.get(pk=self.ticket.pk)
+        self.assertEqual((current.status, current.version, current.updated_at), (
+            Ticket.Status.IN_PROGRESS, self.ticket.version, self.ticket.updated_at,
+        ))
+        self.assertFalse(current.events.filter(action=TicketEvent.Action.SUBMITTED).exists())
+
+    def test_retry_is_rejected_and_returned_ticket_can_be_resubmitted(self):
+        self.client.force_login(self.handler)
+        self.assertRedirects(self.client.post(self.url, self.payload), self.detail_url)
+        current = Ticket.objects.get(pk=self.ticket.pk)
+        self.assertEqual(self.client.post(self.url, self.payload).status_code, 409)
+        self.assertEqual(self.client.post(self.url, {**self.payload, 'version': current.version}).status_code, 409)
+
+        self.client.force_login(self.reporter)
+        return_url = reverse('repair-return', args=[current.pk])
+        self.assertRedirects(self.client.post(return_url, {
+            'version': current.version, 'content': '仍偶尔卡纸。',
+        }), self.detail_url)
+        current.refresh_from_db()
+        self.assertEqual((current.status, current.assignee_id), (Ticket.Status.IN_PROGRESS, self.handler.pk))
+
+        self.client.force_login(self.handler)
+        self.assertEqual(self.client.post(self.url, self.payload).status_code, 409)
+        self.assertRedirects(self.client.post(self.url, {
+            'version': current.version, 'content': '已更换进纸轮。',
+        }), self.detail_url)
+        self.assertEqual(list(current.events.filter(action=TicketEvent.Action.SUBMITTED).values_list('content', flat=True)), [
+            self.payload['content'], '已更换进纸轮。',
+        ])
