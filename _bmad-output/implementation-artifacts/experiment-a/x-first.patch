+class TicketProgressTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        users = get_user_model().objects
+        cls.reporter = users.create_user(username='progress_reporter')
+        cls.handler = users.create_user(username='progress_handler')
+        cls.other_handler = users.create_user(username='progress_other_handler')
+        cls.handlers = Group.objects.create(name=HANDLER_GROUP)
+        cls.handlers.user_set.add(cls.handler, cls.other_handler)
+        cls.ticket = create_ticket(
+            reporter=cls.reporter, device_name='公共打印机', location='公共区', description='卡纸',
+        )
+        claim_ticket(ticket_id=cls.ticket.pk, handler=cls.handler, expected_version=cls.ticket.version)
+        cls.ticket.refresh_from_db()
+
+    def setUp(self):
+        self.url = reverse('repair-progress', args=[self.ticket.pk])
+        self.detail_url = reverse('ticket-detail', args=[self.ticket.pk])
+        self.client.force_login(self.handler)
+
+    def test_current_handler_appends_two_events_and_reporter_sees_history_and_latest(self):
+        browser = Client(enforce_csrf_checks=True)
+        browser.force_login(self.handler)
+        start = self.ticket.version
+        first = datetime(2026, 11, 9, 9, 1, tzinfo=UTC)
+        second = first + timedelta(minutes=5)
+        notes = [('已取出卡纸', first), ('正在检查进纸口', second)]
+
+        for version, (content, occurred_at) in enumerate(notes, start=start):
+            detail = browser.get(self.detail_url)
+            self.assertContains(detail, f'action="{self.url}"')
+            self.assertContains(detail, f'name="version" value="{version}"')
+            self.assertContains(detail, '追加处理进度')
+            with patch('repairs.services.timezone') as clock:
+                clock.now.return_value = occurred_at
+                response = browser.post(self.url, {
+                    'version': version, 'content': content,
+                    'csrfmiddlewaretoken': browser.cookies['csrftoken'].value,
+                    'actor': self.other_handler.pk, 'occurred_at': first.isoformat(),
+                })
+            self.assertRedirects(response, self.detail_url, fetch_redirect_response=False)
+
+        self.ticket.refresh_from_db()
+        self.assertEqual(
+            (self.ticket.status, self.ticket.assignee_id, self.ticket.version, self.ticket.updated_at),
+            (Ticket.Status.IN_PROGRESS, self.handler.pk, start + 2, second),
+        )
+        self.assertEqual(list(self.ticket.events.values_list('action', flat=True)), [
+            TicketEvent.Action.CREATED, TicketEvent.Action.CLAIMED,
+            TicketEvent.Action.PROGRESS, TicketEvent.Action.PROGRESS,
+        ])
+        self.assertEqual(list(self.ticket.events.filter(action=TicketEvent.Action.PROGRESS).values_list(
+            'version', 'actor_id', 'content', 'occurred_at',
+        )), [
+            (start + 1, self.handler.pk, '已取出卡纸', first),
+            (start + 2, self.handler.pk, '正在检查进纸口', second),
+        ])
+
+        self.client.force_login(self.reporter)
+        detail = self.client.get(self.detail_url)
+        self.assertNotContains(detail, f'action="{self.url}"')
+        self.assertContains(detail, '''
+            <section aria-labelledby="latest-progress-heading">
+              <h2 id="latest-progress-heading">最新进度</h2>
+              <p class="event-content">正在检查进纸口</p>
+              <p>记录时间 <time datetime="2026-11-09T17:06:00+0800">2026-11-09 17:06:00</time></p>
+            </section>
+        ''', html=True)
+        history = detail.content.decode().split('<ol>', 1)[1].split('</ol>', 1)[0]
+        self.assertLess(history.index('已取出卡纸'), history.index('正在检查进纸口'))
+        self.assertIn('2026-11-09 17:01:00', history)
+        self.assertIn('2026-11-09 17:06:00', history)
+
+    def test_other_handler_cannot_append_by_forging_the_actor(self):
+        before = self.ticket_snapshot()
+        self.client.force_login(self.other_handler)
+        response = self.client.post(self.url, {
+            'version': self.ticket.version, 'content': '越权更新', 'actor': self.handler.pk,
+        })
+        self.assertEqual(response.status_code, 403)
+        self.assertEqual(self.ticket_snapshot(), before)
+
+    def test_assignee_without_handler_role_cannot_append(self):
+        self.handlers.user_set.remove(self.handler)
+        before = self.ticket_snapshot()
+        self.assertEqual(self.client.post(self.url, {
+            'version': self.ticket.version, 'content': '失去负责人资格后的更新',
+        }).status_code, 403)
+        self.assertEqual(self.ticket_snapshot(), before)
+
+    def test_stale_version_conflicts_and_cannot_append_again(self):
+        data = {'version': self.ticket.version, 'content': '已取出卡纸'}
+        self.assertRedirects(self.client.post(self.url, data), self.detail_url)
+        before = self.ticket_snapshot()
+        response = self.client.post(self.url, {**data, 'content': '旧页面的更新'})
+        self.assertContains(response, '请刷新详情后再试', status_code=409)
+        self.assertEqual(self.ticket_snapshot(), before)
+
+    def test_wrong_status_disables_form_and_rejects_post(self):
+        Ticket.objects.filter(pk=self.ticket.pk).update(status=Ticket.Status.AWAITING_CONFIRMATION)
+        before = self.ticket_snapshot()
+        self.assertNotContains(self.client.get(self.detail_url), f'action="{self.url}"')
+        self.assertEqual(self.client.post(self.url, {
+            'version': self.ticket.version, 'content': '错误状态的更新',
+        }).status_code, 409)
+        self.assertEqual(self.ticket_snapshot(), before)
+
+    def test_invalid_form_and_requests_without_csrf_do_not_write(self):
+        before = self.ticket_snapshot()
+        for data in ({'content': '缺少版本'}, {'version': self.ticket.version, 'content': ' \t'}):
+            with self.subTest(data=data):
+                self.assertEqual(self.client.post(self.url, data).status_code, 400)
+        browser = Client(enforce_csrf_checks=True)
+        browser.force_login(self.handler)
+        self.assertEqual(browser.post(self.url, {
+            'version': self.ticket.version, 'content': '缺少 CSRF 令牌',
+        }).status_code, 403)
+        self.assertEqual(self.ticket_snapshot(), before)
+
+    def test_progress_summary_keeps_event_time_after_a_later_ticket_update(self):
+        self.assertNotContains(self.client.get(self.detail_url), 'id="latest-progress-heading"')
+        progress_at = datetime(2026, 11, 9, 9, 1, tzinfo=UTC)
+        with patch('repairs.services.timezone') as clock:
+            clock.now.return_value = progress_at
+            self.assertRedirects(self.client.post(self.url, {
+                'version': self.ticket.version, 'content': '已取出卡纸',
+            }), self.detail_url)
+            Ticket.objects.filter(pk=self.ticket.pk).update(status=Ticket.Status.AWAITING_CONFIRMATION)
+            clock.now.return_value = progress_at + timedelta(minutes=10)
+            confirm_closed(
+                ticket_id=self.ticket.pk, actor=self.reporter, expected_version=self.ticket.version + 1,
+            )
+
+        self.client.force_login(self.reporter)
+        detail = self.client.get(self.detail_url)
+        self.assertEqual(detail.context['latest_progress'].occurred_at, progress_at)
+        self.assertContains(detail, '记录时间 <time datetime="2026-11-09T17:01:00+0800">')
+        self.assertContains(detail, '<time datetime="2026-11-09T17:11:00+0800">2026-11-09 17:11:00</time>', html=True)
+
+    def test_failed_event_insert_rolls_back_progress_update(self):
+        before = self.ticket_snapshot()
+        with patch('repairs.services.TicketEvent.objects.create', side_effect=IntegrityError('event insert failed')):
+            with self.assertRaises(IntegrityError):
+                self.client.post(self.url, {'version': self.ticket.version, 'content': '已取出卡纸'})
+        self.assertEqual(self.ticket_snapshot(), before)
+
+    def ticket_snapshot(self):
+        ticket = Ticket.objects.values('status', 'assignee_id', 'version', 'updated_at').get(pk=self.ticket.pk)
+        events = list(self.ticket.events.values())
+        return ticket, events
